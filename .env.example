# Copy to .env and edit. Everything has a default.

# Model: qwen36-35b (default; 35B mixture of experts on an 8 GB card), gemma4-e4b, gemma4-12b, gemma4-26b, qwen35-4b
MODEL=qwen36-35b
# Hardware: dgpu = discrete NVIDIA GPU (default), orin = Jetson AGX Orin
PROFILE=dgpu
# dgpu only: CUDA architecture of the card (89 = RTX 40-series, 86 = RTX 30-series, 80 = A100, 120 = RTX 50-series)
#GPU_ARCH=89

# Port of the OpenAI-compatible API: http://localhost:8000/v1 (any API key, model name "local")
#PORT=8000
# Where models, engines and results go (60-120 GB free depending on the model; default ./data)
#DATA_DIR=./data

# Qwen3.6 only: how strongly the router prefers experts that are already in the GPU cache (decode only).
# 0.5 = default, +0.09% perplexity, much faster; 0 = exact routing (lossless); 1 = fastest, +1.5% perplexity.
#CACHE_BIAS=0.5

# Hugging Face token: only for gated models (the Gemma models need an account that accepted the licence)
HF_TOKEN=
# Prebuilt exported weights to download instead of quantising on this machine (set per model in poc/config), or a local export directory
#HF_ONNX_REPO=
# 1 = ignore the prebuilt export and quantise + export the original weights on this machine (hours; needs 40 GB of RAM + swap and the full download)
#QUANTIZE=0
# Fallbacks when the Hugging Face download keeps failing (the free tier rate-limits; a free HF_TOKEN raises the limit; partial downloads always resume):
# a plain HTTPS mirror (directory with a manifest.txt, see poc/tools/make_mirror_manifest.py), or a directory you downloaded by any other means
#ONNX_MIRROR_URL=
#ONNX_DIR=
#ONNX_DIR=

# `docker compose run --rm bench`: recorded requests replayed, HumanEval problems (0 = skip), long-context prompt lengths (empty = skip)
#BENCH_CALLS=60
#BENCH_HUMANEVAL=164
#BENCH_LONGCTX=
#BUILD_JOBS=8
