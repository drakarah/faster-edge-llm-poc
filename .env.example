# Copy to .env and edit. Everything has a default except HF_TOKEN for the Gemma models.

# Hardware: orin = Jetson AGX Orin (sm_87); dgpu = discrete GPU (x86_64 or arm64 server), see GPU_ARCH
PROFILE=orin
# gemma4-e4b (default, 8 GB class), gemma4-12b (bounded long-context engine), qwen35-4b (hybrid model)
MODEL=gemma4-e4b

# Hugging Face token of an account that accepted the Gemma licence (https://huggingface.co/google/gemma-4-E4B-it). Qwen needs none.
HF_TOKEN=

# dgpu only: CUDA architecture of the card (89 = RTX 40-series, 86 = RTX 30-series, 80 = A100, 120 = RTX 50-series)
#GPU_ARCH=89

# Recorded requests replayed per timing round and number of stock/optimised rounds
#BENCH_CALLS=60
#BENCH_HUMANEVAL=164   # public HumanEval problems per run (0 = skip)
#BENCH_ROUNDS=2

# Where models, engines and results go (needs 60-120 GB free; default ./data) and the port of the server that stays up
#DATA_DIR=./data
#PORT=8000
#BUILD_JOBS=8
